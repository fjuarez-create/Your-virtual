# Compilar UNIK Works y subirla a TestFlight, sin Mac y sin que nadie
# tenga que exportar un certificado.
#
# EL PROBLEMA QUE RESUELVE ESTE FICHERO
#
# Para firmar una app de iOS hacen falta dos cosas: un certificado de
# distribución (que lleva una clave privada) y un perfil de
# aprovisionamiento. Lo normal es sacarlos a mano desde un Mac y
# guardarlos en los secretos del repositorio. Fran no tiene Mac, y una
# clave privada no puede viajar por un chat.
#
# Así que aquí no se guarda ninguna: en cada compilación se crea un
# certificado nuevo, se usa, y en la siguiente se revoca antes de crear
# el suyo. Apple solo deja tener dos o tres a la vez, y por eso hay que
# barrer antes de sembrar.
#
# Revocar un certificado NO afecta a las apps ya publicadas en la App
# Store: Apple las vuelve a firmar con el suyo al distribuirlas. Sí
# afectaría a builds repartidos fuera de la tienda, y esta app no
# reparte ninguno.
#
# Lo único que hace falta guardar es la clave de App Store Connect, que
# Fran crea desde la web de Apple en tres clics y pega en los secretos.

default_platform(:ios)

RUTA_PROYECTO = "ios/App"
IDENTIFICADOR = "com.unikdi.repasos"

platform :ios do
  desc "Compila y sube a TestFlight. No envía a revisión."
  lane :publicar do
    clave = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_CLAVE_ID"),
      issuer_id: ENV.fetch("APPSTORE_EMISOR_ID"),
      key_content: ENV.fetch("APPSTORE_CLAVE_P8"),
      is_key_content_base64: false,
      in_house: false
    )

    revocar_certificados_viejos
    ruta_cert = crear_certificado(clave)
    perfil = crear_perfil(clave)

    numerar
    compilar(perfil)
    subir(clave)

    UI.success("Subida la compilación. En unos minutos aparece en TestFlight.")
    ruta_cert
  end

  # ─── Los pasos, uno a uno ──────────────────────────────────────

  # Apple solo admite dos o tres certificados de distribución vivos. Como
  # cada compilación crea el suyo, hay que retirar los anteriores o a la
  # tercera se acabarían las plazas y fallaría sin decir por qué.
  private_lane :revocar_certificados_viejos do
    require "spaceship"
    Spaceship::ConnectAPI.auth(
      key_id: ENV.fetch("APPSTORE_CLAVE_ID"),
      issuer_id: ENV.fetch("APPSTORE_EMISOR_ID"),
      key: ENV.fetch("APPSTORE_CLAVE_P8")
    )
    viejos = Spaceship::ConnectAPI::Certificate.all.select do |c|
      %w[DISTRIBUTION IOS_DISTRIBUTION].include?(c.certificate_type.to_s)
    end
    if viejos.empty?
      UI.message("No había certificados de distribución que retirar.")
    else
      viejos.each do |c|
        UI.message("Retirando el certificado #{c.name} (#{c.id})…")
        begin
          c.delete!
        rescue StandardError => e
          # Que no se pueda retirar uno no puede tumbar la compilación:
          # mientras quede plaza libre, el siguiente paso funciona igual.
          UI.important("No se ha podido retirar #{c.id}: #{e.message}")
        end
      end
    end
  end

  private_lane :crear_certificado do |clave|
    cert(
      api_key: clave,
      generate_apple_certs: true,
      development: false,
      keychain_path: ENV.fetch("LLAVERO_RUTA"),
      keychain_password: ENV.fetch("LLAVERO_CLAVE"),
      output_path: "#{ENV.fetch('RUNNER_TEMP')}/firma"
    )
    lane_context[SharedValues::CERT_FILE_PATH]
  end

  private_lane :crear_perfil do |clave|
    sigh(
      api_key: clave,
      app_identifier: IDENTIFICADOR,
      platform: "ios",
      force: true,
      output_path: "#{ENV.fetch('RUNNER_TEMP')}/firma"
    )
    lane_context[SharedValues::SIGH_NAME]
  end

  # Cada subida a Apple tiene que llevar un número de compilación
  # distinto del anterior. El del propio robot vale y no hay que
  # acordarse de subirlo a mano.
  private_lane :numerar do
    increment_build_number(
      build_number: ENV.fetch("GITHUB_RUN_NUMBER", "1"),
      xcodeproj: "#{RUTA_PROYECTO}/App.xcodeproj"
    )
  end

  private_lane :compilar do |perfil|
    build_app(
      workspace: "#{RUTA_PROYECTO}/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "#{ENV.fetch('RUNNER_TEMP')}/salida",
      output_name: "UNIK-Works.ipa",
      export_options: {
        provisioningProfiles: { IDENTIFICADOR => perfil },
        signingStyle: "manual",
        teamID: ENV.fetch("IOS_EQUIPO")
      },
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('IOS_EQUIPO')} " \
              "PROVISIONING_PROFILE_SPECIFIER='#{perfil}' " \
              "CODE_SIGN_STYLE=Manual",
      silent: false,
      clean: true
    )
  end

  private_lane :subir do |clave|
    upload_to_testflight(
      api_key: clave,
      ipa: "#{ENV.fetch('RUNNER_TEMP')}/salida/UNIK-Works.ipa",
      # No se espera a que Apple termine de procesarla: son diez o quince
      # minutos de máquina alquilada mirando una barra de progreso.
      skip_waiting_for_build_processing: true,
      # Y no se envía a revisión: eso lo decide Fran desde la web.
      distribute_external: false,
      notify_external_testers: false
    )
  end
end

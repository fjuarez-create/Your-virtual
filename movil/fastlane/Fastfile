# Compilar UNIK Works y subirla a TestFlight, sin Mac y sin que nadie
# tenga que exportar un certificado.
#
# EL PROBLEMA QUE RESUELVE ESTE FICHERO
#
# Para firmar una app de iOS hacen falta dos cosas: un certificado de
# distribución (que lleva una clave privada) y un perfil de
# aprovisionamiento. Lo normal es sacarlos a mano desde un Mac y
# guardarlos en los secretos del repositorio. Fran no tiene Mac, y una
# clave privada no puede viajar por un chat.
#
# Así que aquí no se guarda ninguna: en cada compilación se crea un
# certificado nuevo, se usa, y en la siguiente se revoca antes de crear
# el suyo. Apple solo deja tener dos o tres a la vez, y por eso hay que
# barrer antes de sembrar.
#
# Revocar un certificado NO afecta a las apps ya publicadas en la App
# Store: Apple las vuelve a firmar con el suyo al distribuirlas. Sí
# afectaría a builds repartidos fuera de la tienda, y esta app no
# reparte ninguno.
#
# Lo único que hace falta guardar es la clave de App Store Connect, que
# Fran crea desde la web de Apple en tres clics y pega en los secretos.

default_platform(:ios)

RUTA_PROYECTO = "ios/App"
IDENTIFICADOR = "com.unikdi.repasos"
# El Team ID vive en el Appfile porque no es un secreto. Se puede pisar
# con IOS_EQUIPO si algún día hiciera falta otro.
# El `to_s.empty?` importa: si el secreto no existe, GitHub pasa la
# variable vacía en vez de no pasarla, y un `fetch` con valor por
# defecto se quedaría con la cadena vacía.
EQUIPO = ENV["IOS_EQUIPO"].to_s.empty? ? "M8KKGDT273" : ENV["IOS_EQUIPO"]

platform :ios do
  desc "Compila y sube a TestFlight. No envía a revisión."
  lane :publicar do
    clave = app_store_connect_api_key(
      key_id: ENV.fetch("APPSTORE_CLAVE_ID"),
      issuer_id: ENV.fetch("APPSTORE_EMISOR_ID"),
      key_content: ENV.fetch("APPSTORE_CLAVE_P8"),
      is_key_content_base64: false,
      in_house: false
    )

    revocar_certificados_viejos
    crear_certificado(clave: clave)
    perfil = crear_perfil(clave: clave)

    numerar
    compilar(perfil: perfil)
    subir(clave: clave)

    UI.success("Subida la compilación. En unos minutos aparece en TestFlight.")
  end

  desc "Pregunta a App Store Connect cómo está todo y lo cuenta en cristiano. No toca nada."
  lane :estado do
    require "spaceship"
    require "time"

    Spaceship::ConnectAPI.auth(
      key_id: ENV.fetch("APPSTORE_CLAVE_ID"),
      issuer_id: ENV.fetch("APPSTORE_EMISOR_ID"),
      key: ENV.fetch("APPSTORE_CLAVE_P8")
    )

    app = Spaceship::ConnectAPI::App.find(IDENTIFICADOR)
    UI.user_error!("En esta cuenta de Apple no aparece ninguna app con el identificador #{IDENTIFICADOR}.") if app.nil?

    lineas = ["## #{app.name} en App Store Connect", ""]

    # Las versiones de la tienda: la publicada, la que esté en revisión…
    begin
      versiones = app.get_app_store_versions.to_a
      if versiones.empty?
        lineas << "En la tienda todavía no hay ninguna versión creada."
      else
        lineas << "### Versiones en la tienda"
        lineas << ""
        versiones.sort_by { |v| v.created_date.to_s }.reverse.first(3).each do |v|
          # Apple está mudando el nombre del campo del estado; se lee el
          # que haya. Con versiones viejas de fastlane solo existe el
          # segundo.
          bruto = (v.respond_to?(:app_version_state) && v.app_version_state) || v.app_store_state
          lineas << "- **Versión #{v.version_string}** — #{en_cristiano_tienda(bruto)}"
        end
      end
    rescue StandardError => e
      lineas << "No se han podido leer las versiones de la tienda: #{e.message}"
    end

    # Las últimas compilaciones subidas y cómo las tiene TestFlight.
    begin
      builds = Spaceship::ConnectAPI::Build.all(
        app_id: app.id,
        sort: "-uploadedDate",
        includes: "preReleaseVersion,buildBetaDetail"
      )
      lineas << ""
      if builds.empty?
        lineas << "Todavía no se ha subido ninguna compilación."
      else
        lineas << "### Últimas compilaciones subidas"
        lineas << ""
        builds.first(5).each do |b|
          version = b.pre_release_version && b.pre_release_version.version
          cuando = begin
            Time.parse(b.uploaded_date.to_s).localtime.strftime("%d/%m/%Y a las %H:%M")
          rescue StandardError
            b.uploaded_date.to_s
          end
          detalle = b.build_beta_detail
          en_testflight = detalle && (detalle.internal_build_state || detalle.external_build_state)
          texto = b.expired ? "caducada: TestFlight ya no la reparte" : en_cristiano_build(b.processing_state, en_testflight)
          lineas << "- **#{version} (compilación #{b.version})**, subida el #{cuando} — #{texto}"
        end
      end
    rescue StandardError => e
      lineas << "No se han podido leer las compilaciones: #{e.message}"
    end

    texto = lineas.join("\n")
    texto.each_line { |l| UI.message(l.chomp) }
    if ENV["GITHUB_STEP_SUMMARY"]
      File.open(ENV["GITHUB_STEP_SUMMARY"], "a") { |f| f.puts(texto, "") }
    end
  end

  # ─── Los pasos, uno a uno ──────────────────────────────────────

  # Apple solo admite dos o tres certificados de distribución vivos. Como
  # cada compilación crea el suyo, hay que retirar los anteriores o a la
  # tercera se acabarían las plazas y fallaría sin decir por qué.
  private_lane :revocar_certificados_viejos do
    require "spaceship"
    Spaceship::ConnectAPI.auth(
      key_id: ENV.fetch("APPSTORE_CLAVE_ID"),
      issuer_id: ENV.fetch("APPSTORE_EMISOR_ID"),
      key: ENV.fetch("APPSTORE_CLAVE_P8")
    )
    viejos = Spaceship::ConnectAPI::Certificate.all.select do |c|
      %w[DISTRIBUTION IOS_DISTRIBUTION].include?(c.certificate_type.to_s)
    end
    if viejos.empty?
      UI.message("No había certificados de distribución que retirar.")
    else
      viejos.each do |c|
        UI.message("Retirando el certificado #{c.name} (#{c.id})…")
        begin
          c.delete!
        rescue StandardError => e
          # Que no se pueda retirar uno no puede tumbar la compilación:
          # mientras quede plaza libre, el siguiente paso funciona igual.
          UI.important("No se ha podido retirar #{c.id}: #{e.message}")
        end
      end
    end
  end

  private_lane :crear_certificado do |op|
    cert(
      api_key: op[:clave],
      generate_apple_certs: true,
      development: false,
      keychain_path: ENV.fetch("LLAVERO_RUTA"),
      keychain_password: ENV.fetch("LLAVERO_CLAVE"),
      output_path: "#{ENV.fetch('RUNNER_TEMP')}/firma"
    )
    lane_context[SharedValues::CERT_FILE_PATH]
  end

  private_lane :crear_perfil do |op|
    sigh(
      api_key: op[:clave],
      app_identifier: IDENTIFICADOR,
      platform: "ios",
      force: true,
      output_path: "#{ENV.fetch('RUNNER_TEMP')}/firma"
    )
    lane_context[SharedValues::SIGH_NAME]
  end

  # Cada subida a Apple tiene que llevar un número de compilación
  # distinto del anterior. El del propio robot vale y no hay que
  # acordarse de subirlo a mano.
  private_lane :numerar do
    increment_build_number(
      build_number: ENV.fetch("GITHUB_RUN_NUMBER", "1"),
      xcodeproj: "#{RUTA_PROYECTO}/App.xcodeproj"
    )
  end

  private_lane :compilar do |op|
    perfil = op[:perfil]

    # La firma se escribe SOLO en el objetivo «App», dentro del propio
    # proyecto. Antes se pasaba por la línea de órdenes y eso se lo
    # aplicaba a todo lo que hay en el espacio de trabajo, incluidos los
    # módulos de Capacitor, que no se firman: la compilación se caía con
    # «CapacitorStatusBar does not support provisioning profiles».
    update_code_signing_settings(
      path: "#{RUTA_PROYECTO}/App.xcodeproj",
      targets: ["App"],
      use_automatic_signing: false,
      team_id: EQUIPO,
      bundle_identifier: IDENTIFICADOR,
      code_sign_identity: "Apple Distribution",
      profile_name: perfil
    )

    build_app(
      workspace: "#{RUTA_PROYECTO}/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "#{ENV.fetch('RUNNER_TEMP')}/salida",
      output_name: "UNIK-Works.ipa",
      export_options: {
        provisioningProfiles: { IDENTIFICADOR => perfil },
        signingStyle: "manual",
        teamID: EQUIPO
      },
      silent: false,
      clean: true
    )
  end

  private_lane :subir do |op|
    upload_to_testflight(
      api_key: op[:clave],
      ipa: "#{ENV.fetch('RUNNER_TEMP')}/salida/UNIK-Works.ipa",
      # No se espera a que Apple termine de procesarla: son diez o quince
      # minutos de máquina alquilada mirando una barra de progreso.
      skip_waiting_for_build_processing: true,
      # Y no se envía a revisión: eso lo decide Fran desde la web.
      distribute_external: false,
      notify_external_testers: false
    )
  end
end

# ─── Traductores para el carril «estado» ─────────────────────────
#
# Apple contesta con siglas en mayúsculas. Aquí se pasan a frases que
# digan qué está pasando y, cuando toca, qué falta por hacer. Si un día
# aparece una sigla nueva, se enseña tal cual en vez de esconderla.

def en_cristiano_tienda(estado)
  {
    "PREPARE_FOR_SUBMISSION" => "en preparación: todavía no se ha enviado a revisión",
    "READY_FOR_REVIEW" => "lista para enviarse a revisión",
    "WAITING_FOR_REVIEW" => "en la cola de revisión de Apple",
    "IN_REVIEW" => "Apple la está revisando ahora mismo",
    "PENDING_DEVELOPER_RELEASE" => "APROBADA por Apple: solo falta que pulses «Publicar esta versión»",
    "PENDING_APPLE_RELEASE" => "aprobada: Apple la publicará automáticamente",
    "PROCESSING_FOR_DISTRIBUTION" => "aprobada: preparándose para salir en la tienda",
    "READY_FOR_DISTRIBUTION" => "publicada y disponible en la App Store",
    "READY_FOR_SALE" => "publicada y disponible en la App Store",
    "REJECTED" => "RECHAZADA por Apple: los motivos están en el Resolution Center de la web",
    "METADATA_REJECTED" => "rechazada por la ficha (textos, capturas o datos de revisión), no por la app",
    "DEVELOPER_REJECTED" => "retirada de la revisión por ti: hay que volver a enviarla",
    "DEVELOPER_REMOVED_FROM_SALE" => "retirada de la venta por ti",
    "REMOVED_FROM_SALE" => "retirada de la venta",
    "INVALID_BINARY" => "la compilación enviada no vale: hay que subir otra"
  }.fetch(estado.to_s, "estado «#{estado}»")
end

def en_cristiano_build(procesado, en_testflight)
  case procesado.to_s
  when "PROCESSING" then return "Apple todavía la está procesando"
  when "FAILED", "INVALID" then return "Apple la rechazó al procesarla"
  end
  case en_testflight.to_s
  when "IN_BETA_TESTING", "READY_FOR_BETA_TESTING"
    "procesada y disponible en TestFlight"
  when "READY_FOR_BETA_SUBMISSION"
    "procesada; en TestFlight para probadores internos"
  when "WAITING_FOR_BETA_REVIEW"
    "esperando la revisión de TestFlight para probadores externos"
  when "IN_BETA_REVIEW"
    "en revisión de TestFlight para probadores externos"
  when "BETA_REJECTED"
    "rechazada para TestFlight externo"
  when "EXPIRED"
    "caducada: TestFlight ya no la reparte"
  when "MISSING_EXPORT_COMPLIANCE"
    "a falta de contestar la pregunta del cifrado (export compliance) en la web"
  else
    "procesada"
  end
end

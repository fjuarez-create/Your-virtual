# =============================================================================
# UMAIA · Plataforma de financiación participativa
# Copia este fichero a `.env` y rellena los valores. `.env` NO se versiona.
# Ningún valor real debe acabar nunca en el repositorio.
# =============================================================================

NODE_ENV=development
APP_ENV=local

# --- Base de datos -----------------------------------------------------------
# Coincide con infra/docker-compose.yml. En producción, usuario sin permisos de
# DDL y con UPDATE/DELETE revocados sobre audit_log (ver packages/db/sql/).
DATABASE_URL=postgresql://umaia:umaia_local_dev@localhost:5432/umaia?schema=public

# --- URLs públicas -----------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3000
# En producción el panel admin va en un host propio, no en el dominio público.
ADMIN_BASE_URL=http://localhost:3000

# --- Sesiones ----------------------------------------------------------------
# Dos secretos DISTINTOS: los perímetros de inversor y administrador están
# separados también criptográficamente. Genera cada uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INVESTOR_SESSION_SECRET=
ADMIN_SESSION_SECRET=
INVESTOR_SESSION_TTL_HOURS=12
ADMIN_SESSION_TTL_HOURS=4

# --- Cifrado de datos personales ---------------------------------------------
# Clave maestra para el cifrado de sobre de documentos de identidad, IBAN y
# secretos de 2FA. En producción esto lo sustituye un KMS (AWS KMS / GCP KMS):
# la clave nunca debe estar en una variable de entorno en producción.
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_VERSION=1

# --- Almacenamiento de documentos (S3-compatible) ----------------------------
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=eu-west-1
STORAGE_BUCKET=umaia-documents
STORAGE_ACCESS_KEY_ID=umaia_local
STORAGE_SECRET_ACCESS_KEY=umaia_local_dev
# Vida de las URLs firmadas. Corta a propósito.
STORAGE_SIGNED_URL_TTL_SECONDS=300

# --- Correo ------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="UMAIA <no-reply@umaia.example>"

# --- Redis (limitación de frecuencia y cola) ---------------------------------
REDIS_URL=redis://localhost:6379

# =============================================================================
# PROVEEDORES EXTERNOS
#
# Todos en `mock` hasta que el promotor confirme que están contratados y
# entregue credenciales. Los mocks simulan la mecánica del proveedor pero
# NUNCA aprueban una verificación por su cuenta: dejan el expediente en
# revisión manual. La aplicación se niega a arrancar en producción con un
# proveedor de KYC en `mock` salvo que se active ALLOW_MOCK_KYC_IN_PRODUCTION,
# que además deja un aviso permanente en el panel de administración.
# =============================================================================

# --- Verificación de identidad (KYC/KYB) -------------------------------------
KYC_PROVIDER=mock                      # mock | sumsub | veriff | onfido
KYC_API_KEY=
KYC_API_SECRET=
KYC_WEBHOOK_SECRET=

# --- Cribado PEP y listas de sanciones ---------------------------------------
SCREENING_PROVIDER=mock                # mock | complyadvantage | dowjones
SCREENING_API_KEY=

# --- Firma electrónica -------------------------------------------------------
SIGNATURE_PROVIDER=mock                # mock | signaturit | docusign
SIGNATURE_API_KEY=
SIGNATURE_WEBHOOK_SECRET=

# --- Pasarela de pago --------------------------------------------------------
PAYMENT_PROVIDER=mock                  # mock | stripe
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Cuenta bancaria de la cuenta de garantía, para las transferencias manuales.
ESCROW_ACCOUNT_IBAN=
ESCROW_ACCOUNT_HOLDER=

# --- Salvaguarda -------------------------------------------------------------
# Déjalo en `false`. Ponerlo a `true` permite arrancar en producción con
# proveedores mock y queda registrado en el log de auditoría.
ALLOW_MOCK_KYC_IN_PRODUCTION=false

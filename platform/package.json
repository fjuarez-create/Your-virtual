{
  "name": "umaia-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de financiación participativa UMAIA",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:generate": "npm run generate --workspace @umaia/db",
    "db:migrate": "npm run migrate --workspace @umaia/db",
    "db:seed": "npm run seed --workspace @umaia/db",
    "dev": "npm run dev --workspace @umaia/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:db": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f packages/db/sql/verify-invariants.sql",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}

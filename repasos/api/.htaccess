# Todo el tráfico de la API entra por index.php, salvo el instalador.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/
  RewriteRule ^install\.php$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Nada de esta carpeta debe poder leerse directamente salvo los scripts.
<FilesMatch "\.(sql|md|example\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

Options -Indexes
